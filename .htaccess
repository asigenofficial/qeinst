# ==============================================================================
# QEI — Quality Experts Institute for Training
# Production Apache .htaccess Configuration
# ==============================================================================

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. Force HTTPS in Production (uncomment or active behind SSL)
    <IfModule mod_ssl.c>
        RewriteCond %{HTTPS} off
        RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
    </IfModule>

    # 2. Block access to sensitive system, environment, database, and tool files
    RewriteRule ^\.env.*$ - [F,L,NC]
    RewriteRule ^\.git.*$ - [F,L,NC]
    RewriteRule ^.*\.sqlite.*$ - [F,L,NC]
    RewriteRule ^.*\.log$ - [F,L,NC]
    RewriteRule ^package(-lock)?\.json$ - [F,L,NC]
    RewriteRule ^composer\.(json|lock)$ - [F,L,NC]
    RewriteRule ^tools/.*$ - [F,L,NC]
    RewriteRule ^backend/(app|bootstrap|config|database|resources|routes|storage|tests)/.*$ - [F,L,NC]

    # 3. Route /api/* requests to Laravel Backend
    RewriteCond %{REQUEST_URI} ^/api/ [NC]
    RewriteRule ^api/(.*)$ backend/public/index.php [L,QSA]
</IfModule>

# Disable Directory Listing
Options -Indexes

# Custom Error Pages
ErrorDocument 404 /404.html

# UTF-8 Default Encoding
AddDefaultCharset UTF-8

# ==============================================================================
# Security Headers
# ==============================================================================
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"

    # Force HTML, CSS and JS to never be cached by browser
    <FilesMatch "\.(css|js|html)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
</IfModule>

# ==============================================================================
# Gzip / Deflate Compression
# ==============================================================================
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ==============================================================================
# Leverage Browser Caching (Expires)
# ==============================================================================
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 day"

    # Images
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 year"

    # CSS & JavaScript — NO CACHE (always fetch latest version)
    ExpiresByType text/css "access plus 0 seconds"
    ExpiresByType application/javascript "access plus 0 seconds"
    ExpiresByType text/javascript "access plus 0 seconds"

    # Fonts
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
</IfModule>
