APP_NAME="QEI Institute"
APP_ENV=production
APP_KEY=base64:7K58wV1aV3zXNqT79m4v1p0H8Fq3w2X0K+j8/0n1t4Y=
APP_DEBUG=false
APP_TIMEZONE=Asia/Riyadh
APP_URL=https://qeinst.com

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
