# SQLite Mode (default simple zero-config database)
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

# MySQL / MariaDB Mode (Alternative for standard cPanel / RDS):
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=qeinst_db
# DB_USERNAME=qeinst_user
# DB_PASSWORD=your_strong_password

BROADCAST_DRIVER=log
CACHE_DRIVER=file
CACHE_STORE=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
