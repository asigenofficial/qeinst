APP_NAME="QEINST API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Riyadh
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
# MySQL Mode:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=qeinst_db
# DB_USERNAME=qeinst_user
# DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
CACHE_STORE=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Contact form email delivery
# Use MAIL_MAILER=log during local development if SMTP is not configured.
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=info@qeinst.com
MAIL_PASSWORD=
MAIL_SCHEME=
MAIL_EHLO_DOMAIN=
MAIL_FROM_ADDRESS=info@qeinst.com
MAIL_FROM_NAME="QEI Institute"
CONTACT_TO_ADDRESS=info@qeinst.com
