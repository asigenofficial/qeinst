{
    "name": "qeinst/backend",
    "type": "project",
    "description": "QEINST Institute REST API Backend (PHP 8.x + Laravel)",
    "keywords": ["laravel", "framework", "qeinst", "api"],
    "license": "MIT",
    "require": {
        "php": "^8.1 || ^8.2 || ^8.3",
        "guzzlehttp/guzzle": "^7.5",
        "laravel/framework": "^11.0 || ^10.48",
        "laravel/sanctum": "^3.3 || ^4.0",
        "laravel/tinker": "^2.9"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pint": "^1.13",
        "mockery/mockery": "^1.6",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ]
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "audit": {
            "block-insecure": false
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
